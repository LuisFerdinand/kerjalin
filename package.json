{
  "name": "kerjalin-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "db:seed:demo": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts --demo",
    "db:seed:demo:clean": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts --clean-demo",
    "db:seed:me": "tsx --conditions=react-server --env-file=.env.local scripts/seed-me.ts",
    "db:seed:me:clean": "tsx --conditions=react-server --env-file=.env.local scripts/seed-me.ts --clean",
    "deploy:check": "tsx --conditions=react-server scripts/check-deploy.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
