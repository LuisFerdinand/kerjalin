# Salin file ini menjadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
# Jangan pernah meng-commit .env.local.

# ---------------------------------------------------------------------------
# Database — Neon (https://console.neon.tech) → Connection string
# Gunakan connection string "pooled" dengan sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
# URL publik situs (tanpa slash di akhir). Lokal: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Opsional: nomor WhatsApp (format internasional tanpa +), mis. 6281234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# ---------------------------------------------------------------------------
# Autentikasi — Better Auth
# Buat secret acak:  npx @better-auth/cli secret   (atau: openssl rand -base64 32)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=""
# Harus sama dengan NEXT_PUBLIC_APP_URL
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Login dengan Google (opsional — tombol Google hanya muncul bila keduanya diisi)
# 1. https://console.cloud.google.com/apis/credentials → Create Credentials → OAuth client ID
# 2. Application type: Web application
# 3. Authorized JavaScript origins : http://localhost:3000  (+ domain produksi)
# 4. Authorized redirect URIs      : http://localhost:3000/api/auth/callback/google
#                                    https://DOMAIN-ANDA/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Cloudinary (upload gambar produk & bukti transfer) — https://console.cloudinary.com
# Dashboard → Settings → API Keys. API secret hanya dipakai di server.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder tujuan upload di Cloudinary
CLOUDINARY_FOLDER="kerjalin"

# ---------------------------------------------------------------------------
# Seed Super Admin (dipakai oleh `npm run db:seed`)
# Ganti password setelah login pertama. Jangan gunakan nilai ini di produksi.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ganti-dengan-password-kuat"
