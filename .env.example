# Salin file ini menjadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
# Jangan pernah meng-commit .env.local.

# ---------------------------------------------------------------------------
# Database — Neon (https://console.neon.tech) → Connection string
# Gunakan connection string "pooled" dengan sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
# URL publik situs (tanpa slash di akhir). Lokal: http://localhost:3000
# Di Vercel isi dengan domain produksi, mis. https://kerjalin.id. Bila kosong, Vercel memakai domain
# produksi proyek secara otomatis. Preview deployment selalu memakai alamatnya sendiri.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Opsional: nomor WhatsApp (format internasional tanpa +), mis. 6281234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# ---------------------------------------------------------------------------
# Autentikasi — Better Auth
# Buat secret acak:  npx @better-auth/cli secret   (atau: openssl rand -base64 32)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=""
# Opsional di Vercel (otomatis mengikuti NEXT_PUBLIC_APP_URL). Bila diisi, samakan dengan NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL="http://localhost:3000"
# Opsional: alamat tambahan yang boleh memanggil API login, dipisah koma. Perlu bila situs bisa dibuka
# lewat lebih dari satu domain (domain, www, dan *.vercel.app produksi sudah dikenali otomatis).
# Gejala bila kurang: login gagal dengan pesan "Invalid origin".
AUTH_TRUSTED_ORIGINS=""

# ---------------------------------------------------------------------------
# Login dengan Google (opsional — tombol Google hanya muncul bila keduanya diisi)
# 1. https://console.cloud.google.com/apis/credentials → Create Credentials → OAuth client ID
# 2. Application type: Web application
# 3. Authorized JavaScript origins : http://localhost:3000  (+ domain produksi)
# 4. Authorized redirect URIs      : http://localhost:3000/api/auth/callback/google
#                                    https://DOMAIN-ANDA/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Cloudinary (upload gambar produk & bukti transfer) — https://console.cloudinary.com
# Dashboard → Settings → API Keys. API secret hanya dipakai di server.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder tujuan upload di Cloudinary
CLOUDINARY_FOLDER="kerjalin"

# ---------------------------------------------------------------------------
# Pembayaran (Midtrans, Xendit, QRIS) — kredensialnya diisi di panel admin: /admin/pembayaran
# Kredensial disimpan terenkripsi (AES-256-GCM) di database. Kuncinya diturunkan dari variabel ini,
# atau dari BETTER_AUTH_SECRET bila kosong. Bila kunci diganti, kredensial lama harus dimasukkan ulang.
# Buat: openssl rand -base64 32
# ---------------------------------------------------------------------------
PAYMENT_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Seed Super Admin (dipakai oleh `npm run db:seed`)
# Ganti password setelah login pertama. Jangan gunakan nilai ini di produksi.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ganti-dengan-password-kuat"
